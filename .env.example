# =================================================================
# Feels - Environment Configuration
# Hacktoberfest 2026 Dev Challenge: Week 1 ("Touch Grass" Theme)
# =================================================================

# --- Spotify Developer Configuration ---
# Create an application at https://developer.spotify.com/dashboard
# Add redirect URI: http://127.0.0.1:8000/auth/callback
SPOTIFY_CLIENT_ID="your_spotify_client_id_here"
SPOTIFY_CLIENT_SECRET="your_spotify_client_secret_here"
SPOTIFY_REDIRECT_URI="http://127.0.0.1:8000/auth/callback"

# --- SerpAPI Configuration ---
# Get your API key at https://serpapi.com/ (free tier includes 100 searches/mo)
SERPAPI_API_KEY="your_serpapi_api_key_here"

# --- Daily Budgets & Limits ---
# Strict calendar day limits (reset at midnight in APP_TIMEZONE)
USER_DAILY_REFRESH_LIMIT=15
SERPAPI_DAILY_BUDGET=15
APP_TIMEZONE="Asia/Kolkata"

# --- Local Ollama AI Engine ---
# Must be running locally on your laptop with the existing qwen2.5-coder:7b model
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5-coder:7b"
OLLAMA_TIMEOUT_SECONDS=60

# --- Security & Session Storage ---
# Used to sign session cookies securely
SECRET_KEY="generate-a-strong-random-secret-key-for-session-cookies"
COOKIE_SECURE=false

# --- Database ---
DATABASE_PATH="feels.db"
